# Server-only. Never commit actual credentials.
FALKORDB_URL=rediss://scout:REPLACE_ME@YOUR_DATABASE_HOST:6380
FALKORDB_CA_PEM="-----BEGIN CERTIFICATE-----\nYOUR_CA_CERTIFICATE\n-----END CERTIFICATE-----"
SCOUT_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Mandatory for hosted APIs. The Vercel project must retain Vercel Authentication.
SCOUT_PROTECTION_MODE=vercel-auth
BRIGHTDATA_ENABLED=false
BRIGHTDATA_MAX_REQUESTS=5
# Optional: reviewed exact company -> public documentation URL mapping.
SCOUT_COMPANY_SOURCES_JSON={}
